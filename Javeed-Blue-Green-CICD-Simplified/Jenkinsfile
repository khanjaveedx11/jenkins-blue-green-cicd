pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build Check') {
            steps {
                sh 'docker build -t blue-green-app:test .'
            }
        }

        stage('Deploy Blue/Green') {
            steps {
                sh 'chmod +x deploy.sh rollback.sh'
                sh './deploy.sh'
            }
        }
    }

    post {
        success {
            echo 'Blue-Green deployment completed successfully.'
        }
        failure {
            echo 'Deployment failed. Current production traffic was not switched.'
        }
    }
}
